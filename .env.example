# Copy to .env for Docker Compose or local experiments. Never commit .env.

# ---------------------------------------------------------------------------
# Desktop / local backend
# ---------------------------------------------------------------------------
AEC_PORT=8765
# AIEC_DATA_DIR=C:\Users\YourName\AppData\Local\AIEngineeringCompanion
# AEC_STATIC_DIR=C:\path\to\AI-Engineering-Companion\frontend\dist
AEC_MAX_UPLOAD_MB=80
# Optional allow-list for syllabus folder import on non-loopback deployments.
# Desktop imports are loopback-only unless this list is set. Separate roots
# with the OS path separator (; on Windows, : on Linux/macOS).
# AEC_IMPORT_ROOTS=C:\Users\YourName\Downloads\Syllabus

# ---------------------------------------------------------------------------
# Web / Docker Compose
# ---------------------------------------------------------------------------
# Required by docker-compose.yml. Use a URL-safe password (letters and digits),
# or set AEC_DATABASE_URL explicitly with a percent-encoded password.
POSTGRES_PASSWORD=change-this-database-password
AEC_HTTP_PORT=8080
AEC_PUBLIC_URL=https://study.example.com
AEC_ALLOW_REGISTRATION=auto
AEC_SESSION_DAYS=30
AEC_COOKIE_SECURE=auto
AEC_ENV_KEYS_ONLY=1
# AEC_CORS_ORIGINS=https://app.example.com

# ---------------------------------------------------------------------------
# AI providers (server-side only; never expose these in frontend code)
# ---------------------------------------------------------------------------
# AEC_OPENAI_API_KEY=
# AEC_OPENAI_BASE_URL=
# AEC_OPENAI_MODEL=
# Gemini uses the official google-genai SDK. GEMINI_API_KEY and GOOGLE_API_KEY
# are accepted aliases when AEC_GEMINI_API_KEY is unset.
# AEC_GEMINI_API_KEY=
# AEC_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AEC_GEMINI_MODEL=gemini-3.5-flash
# AEC_GROQ_API_KEY=
# AEC_GROQ_BASE_URL=
# AEC_GROQ_MODEL=
# AEC_CUSTOM_API_KEY=
# AEC_CUSTOM_BASE_URL=
# AEC_CUSTOM_MODEL=
# AEC_LOCAL_API_KEY=
# AEC_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
# AEC_LOCAL_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Password-reset email
# ---------------------------------------------------------------------------
# AEC_SMTP_HOST=smtp.example.com
# AEC_SMTP_PORT=587
# AEC_SMTP_USER=no-reply@example.com
# AEC_SMTP_PASSWORD=
# AEC_SMTP_FROM=no-reply@example.com
# AEC_SMTP_TLS=1

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# AEC_DEV_SERVER=http://localhost:5173
# Legacy single-password Basic auth (optional desktop/self-host fallback):
# AEC_WEB_USER=student
# AEC_WEB_PASSWORD=
