# Optional environment overrides for the local backend.
# Copy to .env only if you need to change defaults; never commit .env.

# Port used by the standalone backend (Electron chooses a free port automatically).
AEC_PORT=8765

# Override the data directory (database, uploads, logs, backups).
# AIEC_DATA_DIR=C:\Users\YourName\AppData\Local\AIEngineeringCompanion

# Override the built frontend directory served by FastAPI.
# AEC_STATIC_DIR=C:\path\to\AI-Engineering-Companion\frontend\dist

# Maximum upload size in megabytes.
AEC_MAX_UPLOAD_MB=80

# Development only: start Electron against the Vite dev server.
# AEC_DEV_SERVER=http://localhost:5173
